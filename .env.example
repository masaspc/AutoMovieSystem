# このファイルをコピーして .env を作成すること。実際のシークレット値は絶対に書かない。
# cp .env.example .env

# --- アプリ全般 ---
APP_ENV=development

# --- データベース ---
# ローカル検証(Docker不要): SQLiteファイル
# DATABASE_URL=sqlite:///./local.db
# docker compose 環境: PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auto_movie_system

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# compose環境ではworker/beatを別プロセスで動かすため false。
# ローカルで docker なしに素早く検証したい場合は true にする(D-004)。
CELERY_TASK_ALWAYS_EAGER=false

# --- 秘匿情報の暗号化(OAuthトークン等, Fernetキー) ---
# 生成例: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- 公開ゲート(fail-closedがデフォルト。変更は慎重に) ---
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
AUTO_PUBLISH_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true

# --- FFmpeg/ffprobe(空ならPATH→WinGet展開先の順に自動解決: D-007) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- 生成物ディレクトリ(D-008: この配下のみ許可) ---
GENERATED_DIR=generated

# --- 外部プロバイダー選択(fake|実プロバイダー名。未設定キーでもfakeで全機能デモ可能: D-006) ---
LLM_PROVIDER=fake
TTS_PROVIDER=fake
YOUTUBE_PROVIDER=fake

# --- AI予算(整数マイクロUSD。1 USD = 1,000,000) ---
DAILY_AI_BUDGET_MICRO_USD=5000000
MONTHLY_AI_BUDGET_MICRO_USD=100000000

# --- 実プロバイダー用の認証情報(LLM_PROVIDER等をfake以外にする場合のみ必要) ---
# ANTHROPIC_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
