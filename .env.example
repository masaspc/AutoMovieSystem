# このファイルをコピーして .env を作成すること。実際のシークレット値は絶対に書かない。
# cp .env.example .env

# --- アプリ全般 ---
APP_ENV=development

# --- 管理画面/API全体のHTTP Basic認証(D-019) ---
# ADMIN_PASSWORD未設定時はAPP_ENVがdevelopment/testの場合のみ認証をスキップする
# (それ以外の環境では常に401。fail-closed)。本番運用では必ず強力なパスワードを設定すること。
# docker compose は APP_ENV=production を強制するため、ADMIN_PASSWORD が空のままではログインできない。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- データベース ---
# ローカル検証(Docker不要): SQLiteファイル
# DATABASE_URL=sqlite:///./local.db
# docker compose 環境: PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auto_movie_system

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# compose環境ではworker/beatを別プロセスで動かすため false。
# ローカルで docker なしに素早く検証したい場合は true にする(D-004)。
CELERY_TASK_ALWAYS_EAGER=false

# --- 秘匿情報の暗号化(OAuthトークン等, Fernetキー) ---
# 生成例: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- 公開ゲート(fail-closedがデフォルト。変更は慎重に) ---
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
AUTO_PUBLISH_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true

# --- FFmpeg/ffprobe(空ならPATH→WinGet展開先の順に自動解決: D-007) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- 生成物ディレクトリ(D-008: この配下のみ許可) ---
GENERATED_DIR=generated

# --- ジョブ実行管理(秒単位) ---
# JobRun lease timeout (started→実行中判定、超過でstale復旧: D-016)
JOB_LEASE_TIMEOUT_SECONDS=3600
# FFmpeg/ffprobe タイムアウト
MEDIA_FFMPEG_TIMEOUT_SECONDS=300.0
MEDIA_FFPROBE_TIMEOUT_SECONDS=30.0
# 字幕の動画への焼き込み(既定false: YouTubeの自動字幕/アップロード字幕に委ねる。
# falseでもSRT/VTTファイルはAssetとして生成される)
SUBTITLE_BURN_IN_ENABLED=false
# BGM/SE素材ディレクトリ(assets/bgm/README.md参照。素材が無ければ無音で完走する。
# BGMの雰囲気・音量は制作設定(ProductionSettings)側で動画ごとに指定する)
BGM_ASSETS_DIR=assets/bgm
SE_ASSETS_DIR=assets/se

# --- トレンド情報源(fake|rss)。rssはRSS/AtomフィードURLをカンマ区切りで指定 ---
# 例: TREND_FEED_URLS=https://rss.itmedia.co.jp/rss/2.0/aiplus.xml,https://news.google.com/rss/search?q=生成AI&hl=ja&gl=JP&ceid=JP:ja
TREND_PROVIDER=fake
TREND_FEED_URLS=
TREND_FETCH_LIMIT=20

# --- 毎日投稿の自動化(人間の作業は「承認」だけ) ---
# 夜間自動制作の本数(0で無効)。毎晩、未制作企画のスコア上位を自動レビューまで制作する
AUTO_PRODUCE_DAILY_COUNT=1
# 承認した瞬間にprivateアップロードまで自動実行(公開はAUTO_PUBLISH_ENABLEDゲートのまま)
AUTO_UPLOAD_AFTER_APPROVAL=true

# --- 外部プロバイダー選択(fake|実プロバイダー名。未設定キーでもfakeで全機能デモ可能: D-006) ---
LLM_PROVIDER=fake
TTS_PROVIDER=fake
YOUTUBE_PROVIDER=fake

# --- 実YouTubeプロバイダー設定 ---
YOUTUBE_UPLOAD_CHUNK_SIZE_BYTES=4194304

# --- VOICEVOX / 立ち絵解説動画 ---
# ComposeでVOICEVOXを使う場合: COMPOSE_PROFILES=voicevox, TTS_PROVIDER=voicevox
# ローカルEngineを直接使う場合: VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_TIMEOUT_SECONDS=120
VOICEVOX_SPEAKER_ZUNDAMON=3
VOICEVOX_SPEAKER_METAN=2
VOICEVOX_SPEAKER_TSUMUGI=8
# 掛け合い台本と話者別VOICEVOXを有効にする明示的なオプトイン。既定falseは既存TTSと互換。
DIALOGUE_SCRIPT_ENABLED=false
# 公式素材の利用条件を確認したうえでassets/charactersへ配置後にtrueへ変更。
CHARACTER_RENDER_ENABLED=false
CHARACTER_ASSETS_DIR=assets/characters
# つむぎを使わない場合は zundamon,metan に変更。
DIALOGUE_CAST=zundamon,metan,tsumugi

# --- TTS Generic Command プロバイダー設定(TTS_PROVIDER=generic_commandの場合) ---
# TTS_GENERIC_COMMAND_TEMPLATE='["voicevox_cli", "--text", "{text}", "--voice", "{voice}", "--out", "{output}"]'
TTS_GENERIC_COMMAND_TIMEOUT_SECONDS=60.0

# --- AI予算(整数マイクロUSD。1 USD = 1,000,000) ---
DAILY_AI_BUDGET_MICRO_USD=5000000
MONTHLY_AI_BUDGET_MICRO_USD=100000000

# --- LLM モデルマッピング(LLM_PROVIDER=anthropicの場合) ---
LLM_MODEL_LOW=claude-haiku-4-5-20251001
LLM_MODEL_MID=claude-sonnet-5
LLM_MODEL_HIGH=claude-opus-4-8

# --- ローカルLLM(Ollama/LM Studio/vLLM等のOpenAI互換 Chat Completions API: D-020) ---
# Docker DesktopからホストOSのLLMへ接続: host.docker.internal を使う。
# Dockerなしでアプリを直接起動する場合は localhost に変更する。
# 例: Ollama=http://host.docker.internal:11434/v1, LM Studio=http://host.docker.internal:1234/v1
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama/LM Studioは通常キー不要(空のままでOK)。vLLM等でAPIキーを要求する場合のみ設定。
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL_LOW=qwen3:8b
LOCAL_LLM_MODEL_MID=qwen3:32b
LOCAL_LLM_MODEL_HIGH=qwen3:32b
# ローカル推論は低速なため長めのデフォルト(秒)。
LOCAL_LLM_TIMEOUT_SECONDS=300

# --- model_policy別プロバイダールーティング(D-020) ---
# 空文字ならLLM_PROVIDERに従う。全て同一(または全て空)なら単一プロバイダー、
# 異なる場合のみポリシー別にルーティングされる。有効値: fake|anthropic|local
# 例(ハイブリッド構成: LOW/MIDはローカル、HIGH(公開前最終判定)はAnthropic):
# LLM_PROVIDER_LOW=local
# LLM_PROVIDER_MID=local
# LLM_PROVIDER_HIGH=anthropic
LLM_PROVIDER_LOW=
LLM_PROVIDER_MID=
LLM_PROVIDER_HIGH=

# --- Topic スコアリング重み(合計=1.0でなければならない: app/services/topics/scoring.py) ---
TOPIC_SCORE_WEIGHT_DEMAND=0.25
TOPIC_SCORE_WEIGHT_EXPERTISE=0.20
TOPIC_SCORE_WEIGHT_ORIGINALITY=0.20
TOPIC_SCORE_WEIGHT_REVENUE=0.15
TOPIC_SCORE_WEIGHT_FRESHNESS=0.10
TOPIC_SCORE_WEIGHT_PRODUCTION_COST=0.10

# --- 動画レビュー設定(app/services/reviews/machine.py参照) ---
REVIEW_DURATION_MIN_RATIO=0.85
REVIEW_DURATION_MAX_RATIO=1.15
REVIEW_MIN_WIDTH=1920
REVIEW_MIN_HEIGHT=1080
REVIEW_SILENCE_THRESHOLD_DB=-50.0
REVIEW_SILENCE_MIN_DURATION_SECONDS=10.0
REVIEW_VOLUME_MIN_DB=-30.0
REVIEW_VOLUME_MAX_DB=-5.0

# --- 公開ゲートの高リスク領域キーワード(カンマ区切り) ---
REVIEW_HIGH_RISK_KEYWORDS=投資,医療,法律,セキュリティ

# --- 実プロバイダー用の認証情報(必要な場合のみ設定: D-006) ---
# ANTHROPIC_API_KEY=<your-api-key>
# YOUTUBE_OAUTH_CLIENT_ID=<your-client-id>
# YOUTUBE_OAUTH_CLIENT_SECRET=<your-client-secret>

# --- CSRF Cookie ---
# 未設定(空)なら自動: development/test 以外で Secure 属性を付与。
# TLS終端なしのLAN(http://<IP>:8000)で production 運用する場合のみ false を明示。
# localhost は Secure でもブラウザが許可するため通常は変更不要。
CSRF_COOKIE_SECURE=
